Version: 2.0

#########################
# Alternatives Section
#
# A student has to choose a laptop for the next semester.
# Three candidates with very different profiles.

Alternatives: &alternatives
  ThinkPad:
    price: 1200
    battery: 12
  MacBook:
    price: 1800
    battery: 15
  Chromebook:
    price: 400
    battery: 10

#
# End of Alternatives Section
#####################################

#####################################
# Goal Section
#

Goal:
  name: Buy Laptop
  description: >
    A student has to choose a laptop for the next semester,
    trading off price, battery life and personal ecosystem
    preference.
  author: ahp package
  preferences:
    pairwise:
      - [Price, Battery, 2]
      - [Price, Ecosystem, 3]
      - [Battery, Ecosystem, 2]
  children:
    Price:
      # The cheaper, the better: derive pairwise preferences
      # from the price attribute (capped to the 1/9..9 scale).
      preferences:
        pairwiseFunction:
          function(a1, a2) min(9, max(1/9, a2$price/a1$price))
      children: *alternatives
    Battery:
      # Battery hours are directly comparable: use them as scores.
      preferences:
        scoreFunction:
          function(alternative) alternative$battery
      children: *alternatives
    Ecosystem:
      preferences:
        pairwise:
          - [ThinkPad, MacBook, 1/3]
          - [ThinkPad, Chromebook, 2]
          - [MacBook, Chromebook, 5]
      children: *alternatives

#
# End of Goal Section
#####################################
